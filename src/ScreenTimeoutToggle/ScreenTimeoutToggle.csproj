<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OBDim</AssemblyName>
    <RootNamespace>OBDim</RootNamespace>
    <Version>1.0.6</Version>
    <ApplicationIcon>assets\obdim.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    v1.0.6: lets the test assembly (a) enumerate HotkeyService.NamedKeys via reflection
    and (b) redirect LogService to a temp file. Nothing in the public API changes.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ScreenTimeoutToggle.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\icon-work.ico" />
    <EmbeddedResource Include="assets\icon-away.ico" />
    <EmbeddedResource Include="assets\icon-unknown.ico" />
  </ItemGroup>

</Project>
