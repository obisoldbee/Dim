<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OBDim</AssemblyName>
    <RootNamespace>OBDim</RootNamespace>
    <Version>1.1.0</Version>
    <ApplicationIcon>assets\obdim.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    v1.0.6: lets the test assembly (a) enumerate HotkeyService.NamedKeys via reflection
    and (b) redirect LogService to a temp file. Nothing in the public API changes.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ScreenTimeoutToggle.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    v1.0.7: one icon, not three. assets\icon-work.ico / icon-away.ico / icon-unknown.ico
    were replaced by byte-identical copies of obdim.ico back in 3d9ab2b (unified branding,
    a user decision), so embedding three of them pulled the same 48 KB into the assembly
    three times and TrayApp.IconFor had nothing real to choose between. Mode is now
    reported by the tooltip, the context menu and the balloon.
  -->
  <ItemGroup>
    <EmbeddedResource Include="assets\obdim.ico" />
    <!--
      Provider logos fetched from the macOS Usage-Butler repo (Assets.xcassets @2x,
      commit aa91706) so the quota cards show the real marks, not colour dots.
    -->
    <EmbeddedResource Include="assets\provider-openai.png" />
    <EmbeddedResource Include="assets\provider-minimax.png" />
    <EmbeddedResource Include="assets\provider-ark.png" />
  </ItemGroup>

</Project>
